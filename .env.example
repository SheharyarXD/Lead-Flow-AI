# â”€â”€ Required (production will not start without these) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
APP_SECRET=               # Min 32 chars. Signs sessions AND derives the encryption
                          # key for tenant-supplied credentials. NEVER change this
                          # after first run â€” doing so makes every stored Twilio /
                          # SMTP / OpenAI credential permanently undecryptable.
                          # Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:3306/db)
NODE_ENV=                 # Must be "production" in a deployed environment
PUBLIC_URL=               # Public base URL used to build webhook, checkout and
                          # password-reset links (e.g. https://app.example.com)

# â”€â”€ Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=                     # HTTP port (default 3000)

# â”€â”€ Platform operator â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ADMIN_EMAIL=              # The account registering with this address becomes the
                          # platform operator (role "admin", unlocks /admin).
                          # If left blank, the FIRST account ever registered
                          # becomes the operator instead. Set this explicitly on
                          # any publicly reachable deployment.

# â”€â”€ Twilio (SMS + Voice) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Platform-wide fallback credentials, used only for organizations that have not
# configured their own Twilio account under Settings > Integrations (BYOK).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=      # Sender number for SMS and inbound voice routing
TWILIO_TWIML_APP_SID=     # TwiML App SID whose Voice Request URL points to {PUBLIC_URL}/api/webhooks/voice â€” required for browser click-to-call on the platform Twilio account
EMAIL_WEBHOOK_SECRET=     # Shared secret required on the x-webhook-secret header of inbound email webhook calls (production only)

# â”€â”€ Stripe (Billing) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=    # Signing secret for the /api/webhooks/stripe endpoint
STRIPE_PRICE_ID=          # Price ID for LeadFlow Pro ($197/mo, 30-day trial)
STRIPE_PRICE_PRO=         # Alternative/legacy alias for LeadFlow Pro Price ID
STRIPE_PRICE_STARTER=     # Optional: legacy Starter plan price ID
STRIPE_PRICE_ENTERPRISE=  # Optional: legacy Enterprise plan price ID

# â”€â”€ File Storage (S3-compatible) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Works with AWS S3 or any S3-compatible provider (e.g. Cloudflare R2) â€” set
# S3_ENDPOINT for non-AWS providers, omit it for AWS. Keep the bucket PRIVATE:
# downloads are served through short-lived signed URLs after a membership check.
S3_BUCKET=
S3_REGION=                # Defaults to us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=               # Optional: custom endpoint for R2/MinIO/etc.

# â”€â”€ AI (OpenAI) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Platform-wide fallback key, used only for organizations that have not
# configured their own OpenAI key under Settings > AI Agent (BYOK).
OPENAI_API_KEY=

# â”€â”€ Outbound Email (SMTP) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Platform-wide fallback, used only for organizations that have not configured
# their own SMTP credentials under Settings > Integrations (BYOK). Also used for
# account-level mail (password resets, team invitations).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
